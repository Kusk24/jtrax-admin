# Copy to .env.local for local development. Never commit real values.

# Base URL of jtrax-backend. Leave unset to use http://localhost:8790, which is
# where `go run ./cmd/server` listens in the jtrax-backend repo.
#
# In Vercel (Project Settings > Environment Variables) set this to the deployed
# backend, e.g. https://jtrax-backend.onrender.com — without it the console
# calls localhost and every request fails with "backend unreachable".
#
# Server-side only: it has no NEXT_PUBLIC_ prefix because the browser never
# calls the backend directly. Requests go through app/api/[...path], which
# attaches the session token server-side.
JTRAX_API_URL=

# Public address of jtrax-web-app (the student/parent portal).
#
# Two public pages are routes in that app, not in this console: the tournament
# standings at /t/<id> and the registration form at /register/<id>. Without this
# the console can only show links on the admin domain, which 404 for every
# parent they are sent to — and the registration QR code would be unscannable.
#
# NEXT_PUBLIC_ because it is rendered as a link in the browser; it is a URL meant
# to be handed out, not a secret.
NEXT_PUBLIC_PORTAL_URL=
